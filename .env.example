# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API).
# Sem isso, o "Jogar online" funciona só entre abas do mesmo navegador (modo de teste).
#
# A chave "anon"/"publishable" foi feita para ficar no navegador; pode ir no site.
# NUNCA coloque aqui a chave "service_role"/"secret".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
